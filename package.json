{
  "name": "safeinea-website",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build:css": "tailwindcss -i ./src/input.css -o ./output.css --minify",
    "build:eleventy": "eleventy",
    "build": "npm run build:css && npm run build:eleventy",
    "dev": "concurrently \"tailwindcss -i ./src/input.css -o ./output.css --watch\" \"eleventy --serve\""
  },
  "devDependencies": {
    "@11ty/eleventy": "^2.0.1",
    "concurrently": "^10.0.5",
    "tailwindcss": "^3.4.17"
  }
}
