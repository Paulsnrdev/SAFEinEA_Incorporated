{# Shared footer partial, keyed off the same nav.variant used for the nav partial ("mega" | "simple"). #}
{% set footerEnvHealthBase = footerEnvHealthBase if footerEnvHealthBase != undefined else "/EnvironmentalPublicHealth" %}
{% if (footerVariant or nav.variant) == "mega" %}
<footer class="bg-gray-800 text-white pt-12 pb-6">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 xl:px-8">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-10 lg:gap-6 xl:gap-8">

            <div class="lg:col-span-1 flex flex-col">
                <div class="flex items-center gap-3 mb-6">
                    <img src="{{ site.logoWhite }}" alt="SAFEinEA Logo" class="w-12 h-12 object-contain rounded-full">
                    <h3 class="text-xl font-bold">SAFEinEA Inc.</h3>
                </div>
                <p class="text-gray-400 text-sm leading-relaxed mb-6">Your trusted partner in workplace safety and environmental health consulting across Canada.</p>

                <div class="flex items-center gap-4 flex-wrap mt-auto">
                    <a href="https://csse.org/" target="_blank" rel="noopener" class="w-40 sm:w-48 lg:w-56 hover:opacity-80 transition">
                        <img src="/CSSE Transparent.png" alt="CSSE" class="w-full h-auto object-contain">
                    </a>
                </div>
            </div>

            <div class="lg:ml-6">
                <h4 class="text-lg font-semibold mb-4 text-white">Quick Links</h4>
                <ul class="space-y-2 text-sm text-gray-400">
                    <li><a href="/" class="hover:text-white transition">Home</a></li>
                    <li><a href="/about" class="hover:text-white transition">About Us</a></li>
                    <li><a href="/#services" class="hover:text-white transition">Services</a></li>
                    <li><a href="/#courses" class="hover:text-white transition">Online Courses</a></li>
                    <li><a href="/testimonials" class="hover:text-white transition">Testimonials</a></li>
                    <li><a href="/#contact" class="hover:text-white transition">Contact</a></li>
                </ul>
            </div>

            <div class="lg:col-span-2">
                <h4 class="text-lg font-semibold mb-4 text-white">Our Services</h4>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-8">
                    <div>
                        <h5 class="text-xs font-bold text-gray-300 uppercase tracking-wider mb-3">Occupational Safety</h5>
                        <ul class="space-y-2 text-sm text-gray-400 border-l-2 border-blue-500 pl-3">
                            <li><a href="/#service-1" class="hover:text-white transition">Customized Training</a></li>
                            <li><a href="/#service-2" class="hover:text-white transition">Program Development</a></li>
                            <li><a href="/#service-3" class="hover:text-white transition">On-Site Consulting</a></li>
                            <li><a href="/#service-4" class="hover:text-white transition">SAFE Work Training</a></li>
                            <li><a href="/#service-5" class="hover:text-white transition">Inspections</a></li>
                        </ul>
                    </div>
                    <div>
                        <h5 class="text-xs font-bold text-gray-300 uppercase tracking-wider mb-3">Environmental Health</h5>
                        <ul class="space-y-2 text-sm text-gray-400 border-l-2 border-green-500 pl-3">
                            <li><a href="https://www.safeinea.ca/EnvironmentalPublicHealth#water-quality" class="hover:text-white transition">Water Quality Testing</a></li>
                            <li><a href="https://www.safeinea.ca/EnvironmentalPublicHealth#air-quality" class="hover:text-white transition">Air Quality Sampling</a></li>
                            <li><a href="https://www.safeinea.ca/EnvironmentalPublicHealth#community-wellness" class="hover:text-white transition">Community Wellness</a></li>
                            <li><a href="https://www.safeinea.ca/EnvironmentalPublicHealth#facility-hygiene" class="hover:text-white transition">Facility Hygiene</a></li>
                            <li><a href="https://www.safeinea.ca/EnvironmentalPublicHealth#food-safety" class="hover:text-white transition">Food Safety</a></li>
                        </ul>
                    </div>
                </div>
            </div>

            <div class="pb-4">
                <h4 class="text-lg font-semibold mb-4 text-white">Reach Out</h4>
                <ul class="space-y-3 text-sm text-gray-400">
                    <li class="flex items-start gap-3">
                        <i class="fas fa-envelope mt-1 text-blue-400"></i>
                        <span class="break-all">training@safeinea.ca</span>
                    </li>
                    <li class="flex items-start gap-3">
                        <i class="fas fa-map-marker-alt mt-1 text-blue-400"></i>
                        <span>Serving clients across Canada</span>
                    </li>
                </ul>
                <div class="mt-8 flex gap-4">
                    <a href="#" class="w-8 h-8 rounded-full bg-gray-700 flex items-center justify-center text-gray-400 hover:bg-blue-600 hover:text-white transition"><i class="fab fa-facebook-f text-sm"></i></a>
                    <a href="#" class="w-8 h-8 rounded-full bg-gray-700 flex items-center justify-center text-gray-400 hover:bg-blue-400 hover:text-white transition"><i class="fab fa-twitter text-sm"></i></a>
                    <a href="#" class="w-8 h-8 rounded-full bg-gray-700 flex items-center justify-center text-gray-400 hover:bg-blue-700 hover:text-white transition"><i class="fab fa-linkedin-in text-sm"></i></a>
                </div>
            </div>
        </div>

        <div class="border-t border-gray-700 mt-8 pt-6 text-center text-gray-400 text-sm">
            <p>&copy; 2026 SAFEinEA Incorporated. All rights reserved.</p>
        </div>
    </div>
</footer>
{% else %}
<footer class="bg-gray-800 text-white pt-8 md:pt-12 pb-6">
    <div class="max-w-7xl mx-auto px-4 xl:px-8">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-8 lg:gap-6 xl:gap-8">

            <div class="sm:col-span-2 lg:col-span-1 order-1 flex flex-col h-full">
                <div class="flex items-center mb-4">
                    <img src="{{ site.logoWhite }}" alt="SAFEinEA Logo" class="w-12 h-12 md:w-14 md:h-14 object-contain rounded-full">
                    <h3 class="text-xl font-bold ml-2">{{ site.name }}</h3>
                </div>
                <p class="text-gray-400 mb-6 text-sm lg:text-base">Your trusted partner in workplace safety and environmental health consulting across Canada.</p>

                <div class="flex items-center gap-6 flex-wrap -mt-12 pt-4 border-t border-gray-700 lg:border-none lg:pt-0">
                    <a href="https://csse.org/" target="_blank" rel="noopener noreferrer" class="block w-32 sm:w-40 lg:w-48">
                        <img src="/CSSE Transparent.png" alt="CSSE Certification" class="w-full h-auto object-contain">
                    </a>
                </div>
            </div>

            <div class="order-2 lg:col-span-1 lg:ml-4 xl:ml-8">
                <h4 class="text-lg font-semibold mb-3 md:mb-4">Quick Links</h4>
                <ul class="space-y-2">
                    <li><a href="/" class="text-gray-400 hover:text-white transition block py-1">Home</a></li>
                    <li><a href="/about" class="text-gray-400 hover:text-white transition block py-1">About Us</a></li>
                    <li><a href="/#services" class="text-gray-400 hover:text-white transition block py-1">Services</a></li>
                    <li><a href="/testimonials" class="text-gray-400 hover:text-white transition block py-1">Testimonials</a></li>
                    <li><a href="/#contact" class="text-gray-400 hover:text-white transition block py-1">Contact</a></li>
                </ul>
            </div>

            <div class="order-3 sm:col-span-2 lg:col-span-2">
                <h4 class="text-lg font-semibold mb-3 md:mb-4">Services</h4>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                    <div>
                        <h5 class="text-xs font-bold text-gray-300 uppercase tracking-wider mb-3">Occupational Health &amp; Safety</h5>
                        <ul class="space-y-1 border-l-2 border-blue-500 pl-3">
                            <li><a href="/#service-1" class="text-gray-400 hover:text-white transition text-sm block py-1">Customized Training</a></li>
                            <li><a href="/#service-2" class="text-gray-400 hover:text-white transition text-sm block py-1">Program Development</a></li>
                            <li><a href="/#service-3" class="text-gray-400 hover:text-white transition text-sm block py-1">On-Site Consulting</a></li>
                            <li><a href="/#service-4" class="text-gray-400 hover:text-white transition text-sm block py-1">SAFE Work Training</a></li>
                            <li><a href="/#service-5" class="text-gray-400 hover:text-white transition text-sm block py-1">Inspections</a></li>
                        </ul>
                    </div>
                    <div>
                        <h5 class="text-xs font-bold text-gray-300 uppercase tracking-wider mb-3">Environmental &amp; Public Health</h5>
                        <ul class="space-y-1 border-l-2 border-green-500 pl-3">
                    <li><a href="{{ footerEnvHealthBase }}#water-quality" class="text-gray-400 hover:text-white transition text-sm block py-1">Water Quality Testing</a></li>
                            <li><a href="{{ footerEnvHealthBase }}#air-quality" class="text-gray-400 hover:text-white transition text-sm block py-1">Air Quality Sampling</a></li>
                            <li><a href="{{ footerEnvHealthBase }}#community-wellness" class="text-gray-400 hover:text-white transition text-sm block py-1">Community Wellness</a></li>
                            <li><a href="{{ footerEnvHealthBase }}#facility-hygiene" class="text-gray-400 hover:text-white transition text-sm block py-1">Facility Hygiene</a></li>
                            <li><a href="{{ footerEnvHealthBase }}#food-safety" class="text-gray-400 hover:text-white transition text-sm block py-1">Food Safety</a></li>
                        </ul>
                    </div>
                </div>
            </div>

            <div class="order-4 lg:col-span-1">
                <h4 class="text-lg font-semibold mb-3 md:mb-4">Contact Info</h4>
                <ul class="space-y-3 text-gray-400">
                    <li class="flex items-start">
                        <i class="fas fa-envelope mt-1 mr-3 text-blue-400 text-sm"></i>
                        <span class="break-all text-sm xl:text-base">safetyadvocatesinea@gmail.com</span>
                    </li>
                    <li class="flex items-start">
                        <i class="fas fa-map-marker-alt mt-1 mr-3 text-blue-400"></i>
                        <span class="text-sm xl:text-base">Serving clients across Canada</span>
                    </li>
                </ul>
                <div class="mt-6 flex space-x-4">
                    <a href="#" class="w-8 h-8 rounded-full bg-gray-700 flex items-center justify-center text-gray-400 hover:bg-blue-600 hover:text-white transition duration-300">
                        <i class="fab fa-facebook-f text-sm"></i>
                    </a>
                    <a href="#" class="w-8 h-8 rounded-full bg-gray-700 flex items-center justify-center text-gray-400 hover:bg-blue-400 hover:text-white transition duration-300">
                        <i class="fab fa-twitter text-sm"></i>
                    </a>
                    <a href="#" class="w-8 h-8 rounded-full bg-gray-700 flex items-center justify-center text-gray-400 hover:bg-blue-700 hover:text-white transition duration-300">
                        <i class="fab fa-linkedin-in text-sm"></i>
                    </a>
                </div>
            </div>
        </div>

        <div class="border-t border-gray-700 mt-6 pt-4 text-center text-gray-400 text-sm order-last">
            <p>&copy; {{ footerCopyrightYear or 2026 }} SAFEinEA Incorporated. All rights reserved.</p>
        </div>
    </div>
</footer>
{% endif %}
