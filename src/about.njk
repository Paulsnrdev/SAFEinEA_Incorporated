---
<section class="py-16 bg-white overflow-hidden">
    <div class="max-w-6xl mx-auto px-4">
        <div class="flex flex-col lg:flex-row gap-12">

            <div class="lg:w-2/3">
                <h1 data-aos="fade-down" class="text-4xl font-bold mb-8 text-gray-800">{{ aboutContent.heading }}</h1>

                <div data-aos="zoom-in" data-aos-delay="100" class="mb-12 relative h-64 sm:h-80 md:h-96 overflow-hidden rounded-lg shadow-md">
                    {% for photo in aboutPhotos.photos %}
                    <img src="{{ photo.image }}" alt="{{ photo.alt }}" class="w-full h-full object-contain sm:object-cover absolute inset-0 transition-opacity duration-1000 {% if loop.first %}opacity-100{% else %}opacity-0{% endif %}" id="slide{{ loop.index }}">
                    {% endfor %}
                </div>

                <div data-aos="fade-up" data-aos-delay="200" class="mb-8">
                    {% for paragraph in aboutContent.introParagraphs %}
                    <p class="text-gray-600 mb-6 text-lg leading-relaxed">
                        {{ paragraph }}
                    </p>
                    {% endfor %}
                </div>

                <div data-aos="fade-right" class="mb-8">
                    <h2 class="text-2xl font-semibold mb-4 text-gray-800">{{ aboutContent.mission.heading }}</h2>
                    <p class="text-gray-600 mb-6">
                        {{ aboutContent.mission.text }}
                    </p>
                </div>

                <div data-aos="fade-right" data-aos-delay="100" class="mb-8">
                    <h2 class="text-2xl font-semibold mb-4 text-gray-800">{{ aboutContent.approach.heading }}</h2>
                    <p class="text-gray-600 mb-6">
                        {{ aboutContent.approach.text }}
                    </p>
                </div>

                <div data-aos="fade-up" class="bg-gray-50 p-8 rounded-lg shadow-sm">
                    <h2 class="text-2xl font-semibold mb-6 text-gray-800">{{ aboutContent.founderSectionHeading }}</h2>
                    <div class="flex flex-col md:flex-row gap-8 items-start">
                        <div data-aos="zoom-in" data-aos-delay="200" class="md:w-1/4">
                            <div class="w-40 h-40 rounded-full overflow-hidden mx-auto border-4 border-blue-100">
                                <img src="{{ founder.photo }}" alt="Bamidele Oni, Founder of SAFEinEA" class="w-full h-full object-cover">
                            </div>
                        </div>
                        <div class="md:w-3/4">
                            <h3 class="text-xl font-semibold mb-3 text-gray-800">{{ founder.name }}</h3>
                            {% for paragraph in founder.bio %}
                            <p class="text-gray-600{% if not loop.last %} mb-4{% endif %}">
                                {{ paragraph }}
                            </p>
                            {% endfor %}
                        </div>
                    </div>
                </div>
            </div>

            <div class="lg:w-1/3">
                <div data-aos="fade-left" data-aos-delay="200" class="bg-gray-50 p-6 rounded-lg shadow-md sticky top-24">
                    <h2 class="text-xl font-semibold mb-4 text-gray-800">Our Training Deliverables</h2>
                    <ul class="space-y-3">
                        {% for item in deliverables.deliverables %}
                        <li class="flex items-start">
                            <i class="{{ item.icon }} text-blue-500 mt-1 mr-2"></i>
                            <span class="text-gray-600">{{ item.text }}</span>
                        </li>
                        {% endfor %}
                    </ul>

                    <div class="mt-8">
                        <h2 class="text-xl font-semibold mb-4 text-gray-800">Quick Links</h2>
                        <div class="space-y-4">
                            <a href="https://swmb.bluedrop.io/storefront/safeinea" class="bg-green-600 hover:bg-green-700 text-white font-bold py-3 px-6 rounded-lg transition duration-300 w-full block text-center flex items-center justify-center">
                                <i class="fas fa-user-graduate mr-2"></i> Register for Training
                            </a>
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-[11px]"></div>
                            <a href="/#contact" class="bg-blue-600 hover:bg-blue-700 text-white font-medium py-2 px-4 rounded-lg transition duration-300 w-full block text-center flex items-center justify-center ">
                                <i class="fas fa-envelope mr-1.5 "></i> Contact Us
