title: About Us | SAFEinEA Incorporated
description: "Learn about SAFEinEA Incorporated — our mission, founder Bamidele Oni CRSP, and our commitment to workplace safety and environmental health across Canada."
twitterDescription: "Learn about SAFEinEA Incorporated — our mission, founder, and commitment to safety across Canada."
canonical: https://www.safeinea.ca/about
useAos: true
nav:
  variant: simple
  active: about
  ctaHref: "https://swmb.bluedrop.io/storefront/safeinea"
  ctaLabel: "Register for Training"
  ctaBg: "bg-blue-600"
  ctaHoverBg: "hover:bg-blue-700"
  linkHoverClass: "hover:text-blue-500"
  mobileLinkHoverClass: "hover:text-blue-500"
  underlineColor: "#3b82f6"
pageScripts: |
  <script>
      let currentSlide = 0;
      const slides = document.querySelectorAll('[id^="slide"]');
      const totalSlides = slides.length;

      function showSlide(index) {
          slides.forEach(slide => {
              slide.classList.remove('opacity-100');
              slide.classList.add('opacity-0');
          });

          if(slides[index]) {
              slides[index].classList.remove('opacity-0');
              slides[index].classList.add('opacity-100');
          }
          currentSlide = index;
      }

      function nextSlide() {
          if(totalSlides > 0) {
              currentSlide = (currentSlide + 1) % totalSlides;
              showSlide(currentSlide);
          }
      }

      if(totalSlides > 0) {
          setInterval(nextSlide, 10000);
          showSlide(0);
      }
  </script>
jsonLd: |
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "AboutPage",
    "url": "https://www.safeinea.ca/about",
