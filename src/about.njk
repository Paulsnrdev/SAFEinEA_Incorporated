                                <i class="fab fa-youtube mr-1.5 "></i> Safety Advocate Channel
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div data-aos="flip-up" class="bg-amber-50 p-6 rounded-lg border-l-4 border-amber-600 mt-8 shadow-sm">
