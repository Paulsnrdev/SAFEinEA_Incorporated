                    <h3 class="text-base font-bold text-gray-800 mb-2">{{ course.title }}</h3>
                    <p class="text-sm text-gray-500 mb-4 flex-1">{{ course.description }}</p>
                    <div class="flex items-center justify-between mt-auto">
                        <span class="text-xs text-blue-500 font-semibold uppercase">{{ course.badge }}</span>
                        <span class="text-orange-500 font-bold">{{ course.price }}</span>
