            {% endfor %}
        </div>

        <div data-aos="zoom-in" class="mt-12 text-center">
            <p class="text-gray-500 mb-6 text-base">All courses are self-paced and accessible from any device. Certificates issued upon completion.</p>
            <a href="https://treasurebaseacademy.safeinea.ca/#/public-dashboard" target="_blank" rel="noopener" class="inline-flex items-center justify-center gap-3 bg-orange-500 hover:bg-orange-600 text-white font-bold py-4 px-8 rounded-lg transition duration-300 shadow-md hover:shadow-lg text-lg w-full sm:w-auto">
                <i class="fas fa-graduation-cap"></i> Browse All Courses & Enroll
