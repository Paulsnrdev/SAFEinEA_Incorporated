<section id="contact" class="py-10 md:py-16 lg:py-24 bg-white overflow-hidden scroll-mt-32">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
        <h2 data-aos="fade-up" class="text-3xl md:text-4xl font-bold mb-12 text-center text-gray-800">Contact Information</h2>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 xl:gap-8">
            {% for card in contactCards %}
            <div data-aos="fade-up" data-aos-delay="{{ loop.index0 * 100 }}" class="bg-gray-50 p-6 rounded-xl shadow-sm border border-gray-100 hover:shadow-md transition duration-300">
                <div class="w-12 h-12 bg-blue-100 rounded-full flex items-center justify-center mb-4">
                    <i class="{{ card.icon }} text-blue-600 text-xl"></i>
                </div>
                <h3 class="text-lg font-semibold text-gray-800 mb-3">{{ card.title }}</h3>
                {% if card.rows %}
                <div class="space-y-2 text-sm">
                    {% for row in card.rows %}
                    <p class="text-gray-600{% if row.extraGapBefore %} mt-2{% endif %}"><span class="font-medium text-gray-800 block">{{ row.label }}</span> {% if row.link %}<a href="{{ row.link }}" class="text-blue-600 hover:underline{% if row.breakAll %} break-all{% endif %}">{{ row.value }}</a>{% else %}{{ row.value }}{% endif %}</p>
                    {% endfor %}
                </div>
                {% elif card.hours %}
                <ul class="space-y-3 text-sm">
                    {% for h in card.hours %}
                    <li class="flex justify-between items-center{% if not loop.last %} pb-2 border-b border-gray-200{% endif %}">
                        <span class="text-gray-600">{{ h.day }}</span>
                        <span class="font-medium text-gray-800">{{ h.time }}</span>
                    </li>
                    {% endfor %}
                </ul>
                {% elif card.checklist %}
                <ul class="space-y-2 text-sm text-gray-600">
                    {% for item in card.checklist %}
                    <li class="flex items-start gap-2"><i class="fas fa-check text-green-500 mt-1 shrink-0"></i> <span>{{ item }}</span></li>
                    {% endfor %}
                </ul>
                {% endif %}
            </div>
            {% endfor %}
        </div>
    </div>
</section>
